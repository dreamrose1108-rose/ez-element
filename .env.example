# Server-side only. Never put these values in miniprogram/ or commit real secrets.
EZ_ENV_ID=everyday-rose-d0gihszbt1940f4d1
EZ_APP_ID=wx6d8fac347b122572
# Optional direct-PostgreSQL adapter settings. The current shared CloudBase
# environment uses ExecutePGSql and does not expose or require these values.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=ez_api
PGPASSWORD=
# Default: TLS with certificate verification. Set EZ_PG_CA if the console
# provides a private CA. Use disable only for a documented private/local path.
EZ_PG_SSL=verify-full
# EZ_PG_CA=
# getLoginTicket only: inject these through server secrets, never client config.
EZ_WX_APP_SECRET=
# JSON contents of the matching environment's custom-login credentials file.
EZ_TCB_LOGIN_CREDENTIALS=
