{
  "name": "ez-element",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.miniprogram.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:demo": "tsx server/demo.ts",
    "build:production": "node scripts/build.mjs --production"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "3.18.7",
    "wx-server-sdk": "4.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "miniprogram-api-typings": "5.2.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
