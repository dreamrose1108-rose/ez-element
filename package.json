{
  "name": "ez-element",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.miniprogram.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run test:postgres && npm run build",
    "dev:demo": "tsx server/demo.ts",
    "build:production": "node scripts/build.mjs --production",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "dependencies": {
    "@cloudbase/manager-node": "5.9.3",
    "@cloudbase/node-sdk": "3.18.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudbase/adapter-wx_mp": "1.3.1",
    "@cloudbase/js-sdk": "2.27.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "miniprogram-api-typings": "5.2.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
