/* Shared yellow/gray theme lives in app.wxss. */

.edit-sheet{max-height:88vh;}
.member-sheet{max-height:85vh;box-sizing:border-box;}
.page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom));}
.workspace-header{position:sticky;top:0;z-index:10;background:#f4f4f3;margin:-28rpx -32rpx 24rpx;padding:22rpx 24rpx 0;border-bottom:1rpx solid #dededb;}
.workspace-header .brand{margin-bottom:16rpx;}
.workspace-header .brand-cn{font-size:34rpx;letter-spacing:1rpx;}
.workspace-header .brand-en{font-size:14rpx;}
.workspace-header .roles{margin-bottom:12rpx;}
.workspace-header .roles button{padding:12rpx 8rpx;}
.top-nav{display:flex;gap:4rpx;padding-bottom:12rpx;}
.top-nav button{flex:1;min-width:0;padding:22rpx 2rpx;font-size:24rpx;background:transparent;color:#66686a;border-radius:12rpx;white-space:nowrap;}
.top-nav .on{background:#f5cf38;color:#252629;font-weight:800;}
.quick-actions{display:flex;gap:16rpx;margin-bottom:20rpx;}
.quick-actions button{flex:1;font-size:24rpx;margin:0;padding:24rpx 12rpx;}
.pay-card{margin:24rpx 0;padding:30rpx;border-radius:24rpx;background:#252629;color:#fff;box-shadow:0 10rpx 28rpx rgba(37,38,41,.16);}
.pay-eyebrow{display:block;color:#f5cf38;font-size:22rpx;font-weight:800;letter-spacing:1rpx;}
.pay-title,.pay-total{margin-top:8rpx;font-size:52rpx;line-height:1.1;font-weight:900;}
.pay-total{font-size:42rpx;}
.pay-chip{padding:8rpx 14rpx;border-radius:999rpx;background:#f5cf38;color:#252629;font-size:20rpx;font-weight:800;}
.pay-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin:28rpx 0 20rpx;}
.pay-metrics view{padding:18rpx 8rpx;border-radius:14rpx;background:#343538;text-align:center;}
.pay-metrics text{display:block;font-size:20rpx;color:#c9cacc;}
.pay-metrics text:first-child{margin-bottom:6rpx;color:#fff;font-size:29rpx;font-weight:900;}
.pay-detail{display:block;color:#bfc0c2;font-size:21rpx;line-height:1.65;}
.pay-divider{height:1rpx;margin:26rpx 0;background:#505156;}
.pay-breakdown{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin:22rpx 0;}
.pay-breakdown text{padding:14rpx;border-radius:12rpx;background:#343538;font-size:21rpx;}
.coach-pay-setting{margin:24rpx 0;padding:22rpx;border-radius:18rpx;background:#f2f2ef;}
.admin-finance-card{margin:24rpx 0;padding:28rpx;border-radius:24rpx;background:#fff;border:2rpx solid #252629;box-shadow:0 8rpx 24rpx rgba(37,38,41,.08);}
.finance-eyebrow{display:block;font-size:22rpx;font-weight:800;color:#6b5a10;}
.finance-total{margin-top:6rpx;font-size:48rpx;line-height:1.15;font-weight:900;color:#252629;}
.finance-caption{font-size:21rpx;color:#6b6d70;}
.finance-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin:24rpx 0;}
.finance-metrics view{padding:18rpx 8rpx;border-radius:14rpx;background:#f2f2ef;text-align:center;}
.finance-metrics text{display:block;font-size:19rpx;color:#6b6d70;}
.finance-metrics text:first-child{margin-bottom:6rpx;font-size:27rpx;font-weight:900;color:#252629;}
.finance-metrics .negative text:first-child{color:#b23b30;}
.finance-section{margin:22rpx 0 12rpx;}
.coach-pay-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 0;border-top:1rpx solid #e5e5e1;}
.coach-pay-row .muted{display:block;margin-top:5rpx;font-size:20rpx;}
.pay-row-total{text-align:right;white-space:nowrap;}
.pay-row-total text{display:block;font-weight:900;}
.pay-row-total text:last-child{margin-top:4rpx;font-size:19rpx;font-weight:500;color:#77797c;}
.finance-note{display:block;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #e5e5e1;font-size:20rpx;line-height:1.6;color:#77797c;}
.booking-card{border-left:8rpx solid #f5cf38;transition:background-color .2s,border-color .2s;}
.booking-card.status-attended{background:#e9f5ed;border-color:#78ad88;}
.booking-card.status-attended .badge{background:#cfe8d6;color:#245b35;}
.price-detail{display:block;margin-top:14rpx;padding:14rpx 18rpx;border-radius:12rpx;background:#fff3bd;color:#5e4a00;font-size:24rpx;font-weight:700;}
.price-detail text{font-size:24rpx;}
.pack-price{display:flex;justify-content:space-between;gap:16rpx;margin:18rpx 0 10rpx;padding-top:16rpx;border-top:1rpx solid #dbc875;font-size:24rpx;font-weight:700;}
.page button.wide{width:100%;box-sizing:border-box;margin-left:0;margin-right:0;}
.receipt-detail{line-height:1.8;margin:20rpx 0;color:#424448;overflow-wrap:break-word;}
.time-picker-row{display:flex;gap:20rpx;margin-top:12rpx;}
.time-picker-row picker{flex:1;min-width:0;}
.time-picker-row .picker{display:block;}
.time-value{font-size:36rpx;font-weight:700;margin-top:8rpx;}
.publish-card .primary{margin-top:20rpx;}
.slot-board{padding:24rpx;}
.slot-legend{display:flex;gap:10rpx;flex-wrap:wrap;margin:20rpx 0 14rpx;}
.slot-legend text{padding:8rpx 14rpx;border-radius:999rpx;font-size:22rpx;font-weight:700;}
.slot-legend .free{background:#ececea;color:#686a6d;}
.slot-legend .scheduled{background:#fff0a8;color:#6a5200;}
.slot-legend .booked{background:#252629;color:#f5cf38;}
.slot-legend .rest{background:#dfe4e7;color:#495057;}
.week-timeline{display:flex;gap:8rpx;margin-bottom:18rpx;touch-action:none;}
.week-labels{flex:0 0 88rpx;}
.week-label-head,.week-day-label{display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;border-radius:10rpx;font-weight:800;}
.week-label-head{height:58rpx;margin-bottom:6rpx;background:#252629;color:#f5cf38;font-size:19rpx;}
.week-day-label{height:86rpx;margin-bottom:6rpx;background:#252629;color:#f5cf38;font-size:19rpx;}
.week-day-label text:last-child{font-size:16rpx;color:#fff;margin-top:3rpx;}
.week-time-scroll{flex:1;min-width:0;white-space:nowrap;}
.week-time-canvas{width:2460rpx;}
.week-time-head,.week-day-slots{display:grid;grid-template-columns:repeat(28,84rpx);gap:4rpx;}
.week-time-head{height:58rpx;margin-bottom:6rpx;align-items:center;}
.week-time-head text{font-size:18rpx;font-weight:800;text-align:center;color:#5e6063;}
.week-day-slots{height:86rpx;margin-bottom:6rpx;grid-auto-flow:column;}
.schedule-block{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;height:86rpx;padding:6rpx 4rpx;border:2rpx solid transparent;border-radius:9rpx;line-height:1.1;text-align:center;box-sizing:border-box;user-select:none;overflow:hidden;}
.schedule-block.free{background:#f1f1ef;color:#55585b;border-color:#dededb;}
.schedule-block.scheduled{background:#fff4bd;color:#4d410c;border-color:#f5cf38;}
.schedule-block.booked{background:#252629;color:#f5cf38;border-color:#252629;}
.schedule-block.rest{background:#e1e6e8;color:#454b50;border-color:#c9d0d4;}
.schedule-block.selected{background:#f5cf38;color:#252629;border-color:#252629;transform:scale(.97);}
.schedule-block.disabled{opacity:.5;}
.slot-time{max-width:100%;font-size:19rpx;font-weight:800;white-space:normal;}
.slot-state{font-size:16rpx;font-weight:700;margin-top:5rpx;}
