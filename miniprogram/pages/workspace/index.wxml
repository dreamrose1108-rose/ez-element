<view class="page">
  <view wx:if="{{demo}}" class="demo">本地开发演示 · 非真实账户与收款</view>
  <view class="brand"><view><text class="brand-cn">元素领域</text><text class="brand-en">Ez Element / MOVE WITH PURPOSE</text></view><text class="badge">{{roleName}}</text></view>
  <view class="roles" wx:if="{{roles.length > 1}}"><button wx:for="{{roles}}" wx:key="id" data-role="{{item.id}}" bindtap="switchRole" class="{{role === item.id ? 'active' : ''}}">{{item.name}}</button></view>
  <view class="error" wx:if="{{error}}">{{error}}<button bindtap="refresh" size="mini">重试加载</button></view>
  <view wx:if="{{busy}}" class="hint">正在处理，请稍候…</view>
  <view wx:if="{{!profile && !busy && !error}}" class="card">
    <view class="title">加入元素领域</view><text class="muted">填写资料，由门店审核后开通预约。</text>
    <form bindsubmit="register"><input name="name" placeholder="姓名" maxlength="40"/><input name="phone" placeholder="手机号（用于门店联系）" type="number" maxlength="11"/><button form-type="submit" class="primary" disabled="{{busy}}">提交入会申请</button></form>
  </view>
  <view wx:elif="{{profile && profile.status !== 'active'}}" class="empty">{{profile.status === 'pending' ? '资料已提交，等待门店审核。' : '账户已停用，请联系门店处理已有预约。'}}</view>
  <block wx:elif="{{profile && profile.status === 'active'}}">
    <block wx:if="{{tab === 'home'}}">
      <view class="greeting">你好，{{profile.name}}<text class="muted">把时间留给更好的自己</text></view>
      <view class="hero"><text class="eyebrow">EZ ELEMENT TRAINING CLUB</text><view class="hero-title">每一次训练，<view>都是新的可能。</view></view><text class="hero-sub">私教专属指导 / 团课一起进步</text><view class="ring"></view></view>
      <view class="metrics"><view><text class="number">{{totalAvailable}}</text><text>可用课时</text></view><view><text class="number">{{totalFrozen}}</text><text>已冻结</text></view><view><text class="number">{{myCount}}</text><text>待上课预约</text></view></view>
      <button class="primary wide" data-tab="schedule" bindtap="switchTab">{{role === 'student' ? '预约训练 · 选日期与时间' : '查看一周排课'}} →</button>
      <view class="section">{{role === 'student' ? '我的预约' : '授课与出勤'}}</view>
      <view wx:if="{{!bookings.length}}" class="empty">暂无预约记录</view>
      <view class="card" wx:for="{{bookings}}" wx:key="id">
        <view class="row"><text class="title">{{item.title}}</text><text class="badge">{{item.statusName}}</text></view>
        <text class="schedule">{{item.schedule}}</text><text class="muted">{{role === 'student' ? '本次课时' : '学员 ' + item.memberName}} · {{item.cost}} 节</text>
        <button wx:if="{{role === 'student' && item.canCancel}}" class="secondary" data-id="{{item.id}}" bindtap="cancelBooking" disabled="{{busy}}">取消预约</button>
        <text class="muted" wx:if="{{role === 'student' && item.status === 'confirmed' && !item.canCancel}}">需要变更请联系门店</text>
        <view wx:if="{{role !== 'student' && item.canSettle}}" class="row actions"><button class="primary" data-id="{{item.id}}" data-outcome="attended" bindtap="settle" disabled="{{busy}}">确认到课</button><button class="secondary" data-id="{{item.id}}" data-outcome="absent" bindtap="settle" disabled="{{busy}}">标记爽约</button></view>
      </view>
    </block>
    <block wx:if="{{tab === 'schedule'}}">
      <view class="page-title">{{role === 'student' ? '为训练留个时间' : '一周课程安排'}}</view><text class="muted">{{role === 'student' ? '私教选时段，团课选已发布场次' : '按具体日期管理，已有预约的时段不可直接关闭'}}</text>
      <scroll-view scroll-x class="dates"><view class="date-row"><button wx:for="{{days}}" wx:key="key" class="date {{day === item.key ? 'selected' : ''}}" data-day="{{item.key}}" bindtap="chooseDay"><text>{{item.label}}</text><text>{{item.short}}</text></button></view></scroll-view>
      <view class="segments" wx:if="{{role !== 'coach'}}"><button class="{{kind === 'private' ? 'selected' : ''}}" data-kind="private" bindtap="chooseKind">私教预约</button><button class="{{kind === 'group' ? 'selected' : ''}}" data-kind="group" bindtap="chooseKind">团课场次</button></view>
      <picker wx:if="{{role !== 'coach'}}" range="{{coaches}}" range-key="name" value="{{coachIndex}}" bindchange="chooseCoach"><view class="picker">教练：{{coaches[coachIndex].name || '暂无教练'}} <text>更换 ›</text></view></picker>
      <view class="section">{{day}} · {{sessions.length}} 个已发布时段</view>
      <view class="empty" wx:if="{{!sessions.length}}">当天暂无已发布课程，请切换日期。</view>
      <view class="session-list {{kind === 'private' && role === 'student' ? 'slot-grid' : ''}}">
        <view class="card session" wx:for="{{sessions}}" wx:key="id">
          <view class="row"><text class="time">{{item.startLabel}}</text><text class="badge">{{item.kindName}}</text></view><text class="muted">至 {{item.endLabel}}</text>
          <view class="title">{{item.title}}</view><text class="muted">{{item.coachName}} · {{item.roomId}}</text><text class="muted">{{item.cost}} 节课时 · 余 {{item.free}} / {{item.capacity}} 位</text>
          <button wx:if="{{role === 'student'}}" class="primary" disabled="{{!item.canBook || busy}}" data-id="{{item.id}}" bindtap="selectSession">{{item.canBook ? '选择时段' : '暂不可约'}}</button>
          <button wx:elif="{{item.canClose}}" class="secondary" data-id="{{item.id}}" bindtap="closeSlot" disabled="{{busy}}">关闭空闲时段</button>
        </view>
      </view>
      <view wx:if="{{role !== 'student'}}" class="card">
        <view class="title">{{role === 'coach' ? '新增当天可约时段' : '发布课程场次'}}</view><text class="muted">日期 {{day}} · {{role === 'coach' || kind === 'private' ? '一对一私教' : '多人团课'}}；起止时间使用 24 小时制</text>
        <form bindsubmit="publish"><input name="title" placeholder="课程名称" value="{{role === 'coach' || kind === 'private' ? '专属力量训练' : '活力燃脂团课'}}"/><view class="row"><input name="start" placeholder="开始，如 09:00"/><input name="end" placeholder="结束，如 10:00"/></view><input name="room" placeholder="上课地点" value="开放区"/><input wx:if="{{role === 'admin' && kind === 'group'}}" name="capacity" type="number" placeholder="团课人数上限" value="10"/><button class="primary" form-type="submit" disabled="{{busy}}">发布时段</button></form>
      </view>
    </block>
    <block wx:if="{{tab === 'account'}}">
      <view class="page-title">每一节，都有记录</view><text class="muted">预约冻结，到课后消耗，取消退回原课包。</text>
      <view class="pack" wx:for="{{packs}}" wx:key="id"><view class="row"><text class="title">{{item.title}}</text><text class="badge">{{item.expired ? '已到期' : '次卡'}}</text></view><view class="metrics"><view><text class="number">{{item.available}}</text><text>{{item.expired ? '到期余额' : '可用'}}</text></view><view><text class="number">{{item.frozen}}</text><text>冻结</text></view><view><text class="number">{{item.consumed}}</text><text>已消耗</text></view></view><text class="muted">有效期至 {{item.expiry}}</text></view>
      <view wx:if="{{!packs.length}}" class="empty">暂无课包，请联系门店线下购课。</view>
      <block wx:if="{{role === 'admin'}}"><view class="section">线下收款登记</view><view class="card"><text class="muted">确认已收到款项后登记；当前表单记录转账收款。</text><picker range="{{users}}" range-key="name" value="{{memberIndex}}" bindchange="chooseMember"><view class="picker">学员：{{users[memberIndex].name || '暂无已审核学员'}} ›</view></picker><picker range="{{kindNames}}" value="{{purchaseKindIndex}}" bindchange="choosePurchaseKind"><view class="picker">课包类型：{{kindNames[purchaseKindIndex]}} ›</view></picker><picker wx:if="{{purchaseKindIndex === 0}}" range="{{coaches}}" range-key="name" value="{{coachIndex}}" bindchange="chooseCoach"><view class="picker">绑定教练：{{coaches[coachIndex].name || '暂无教练'}} ›</view></picker><form bindsubmit="purchase"><input name="credits" type="number" placeholder="课时数量"/><input name="amount" type="digit" placeholder="实际收款（元）"/><input name="expiry" placeholder="有效期，如 2027-04-27"/><input name="note" placeholder="收款凭据 / 备注（必填）"/><button class="primary" form-type="submit" disabled="{{busy || !users.length}}">确认已收款并开卡</button></form></view><view class="section">待审核学员</view><view wx:for="{{pending}}" wx:key="id" class="card row"><text>{{item.name}}</text><button class="primary compact" data-id="{{item.id}}" bindtap="approve" disabled="{{busy}}">审核通过</button></view><text wx:if="{{!pending.length}}" class="muted">暂无待审核申请</text></block>
      <view class="section">课时流水</view><view class="ledger" wx:for="{{ledger}}" wx:key="id"><view><text>{{item.title}}</text><text class="muted">{{item.date}}</text></view><view class="muted">可用 {{item.delta.available}} / 冻结 {{item.delta.frozen}} / 消耗 {{item.delta.consumed}}</view></view>
    </block>
    <block wx:if="{{tab === 'messages'}}"><view class="page-title">消息通知</view><text class="muted">站内记录；微信订阅提醒将在账号开通后接入。</text><view wx:for="{{messages}}" wx:key="id" class="card"><view class="title">{{item.title}}</view><text class="muted">{{item.date}}</text></view><view wx:if="{{!messages.length}}" class="empty">暂无消息</view></block>
    <view class="bottom-nav"><button class="{{tab === 'home' ? 'on' : ''}}" data-tab="home" bindtap="switchTab">首页</button><button class="{{tab === 'schedule' ? 'on' : ''}}" data-tab="schedule" bindtap="switchTab">{{role === 'student' ? '约课' : '排课'}}</button><button class="{{tab === 'account' ? 'on' : ''}}" data-tab="account" bindtap="switchTab">{{role === 'admin' ? '管理' : '课包'}}</button><button class="{{tab === 'messages' ? 'on' : ''}}" data-tab="messages" bindtap="switchTab">消息</button></view>
  </block>
</view>
<view wx:if="{{selectedId}}" class="overlay"><view class="sheet"><view class="row"><text class="page-title">确认预约</text><button class="compact secondary" bindtap="dismiss">关闭</button></view><view class="title">{{selectedTitle}}</view><text class="schedule">{{selectedTime}}</text><picker wx:if="{{eligible.length}}" range="{{eligible}}" range-key="label" value="{{packageIndex}}" bindchange="choosePackage"><view class="picker">{{eligible[packageIndex].label}} ›</view></picker><text class="muted" wx:else>没有适用课包，请联系门店购课或延期。</text><view class="notice">本次冻结 {{selectedCost}} 节，开课前 {{selectedCancel}} 小时可自助取消。</view><button class="primary" bindtap="confirmBook" disabled="{{!eligible.length || busy}}">确认预约 · 冻结 {{selectedCost}} 节</button></view></view>
