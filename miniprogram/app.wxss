page{background:#f4f4f3;color:#252629;font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}view,button,input{box-sizing:border-box}button{font-size:26rpx;border-radius:16rpx;line-height:1.45;padding:22rpx 24rpx;margin:0;font-weight:600}button::after{border:0}button[disabled]{background:#e2e2df!important;color:#969696!important}text{display:inline-block}input{background:#f4f4f3;border:1rpx solid #e2e2df;border-radius:12rpx;height:88rpx;padding:0 22rpx;margin:18rpx 0;min-width:0;flex:1}.page{padding:28rpx 32rpx 180rpx}.demo{font-size:22rpx;background:#fff1b8;color:#745e12;padding:14rpx;border-radius:10rpx;margin-bottom:22rpx}.brand{display:flex;justify-content:space-between;align-items:center;margin-bottom:28rpx}.brand-cn{display:block;font-size:40rpx;font-weight:800;letter-spacing:5rpx}.brand-en{font-size:15rpx;letter-spacing:2rpx;margin-top:8rpx}.badge{font-size:22rpx;padding:8rpx 14rpx;background:#f6edc8;border-radius:12rpx;white-space:nowrap}.roles,.segments{display:flex;background:#e9e9e7;padding:6rpx;border-radius:16rpx;margin-bottom:24rpx}.roles button,.segments button{flex:1;background:transparent;padding:16rpx 10rpx;font-size:25rpx}.roles .active{background:#252629;color:#f5cf38}.selected{background:#f5cf38!important;color:#252629}.greeting{font-size:38rpx;font-weight:700;margin:30rpx 0 24rpx}.muted{display:block;color:#737477;font-size:24rpx;font-weight:400;line-height:1.8}.greeting .muted{margin-top:8rpx}.hero{position:relative;overflow:hidden;background:#252629;color:#fff;border-radius:28rpx;padding:36rpx;min-height:300rpx}.eyebrow{color:#f5cf38;font-size:18rpx;letter-spacing:2rpx}.hero-title{font-size:45rpx;font-weight:800;line-height:1.45;margin:20rpx 0;position:relative;z-index:1}.hero-sub{font-size:22rpx;color:#cececc;position:relative;z-index:1}.ring{position:absolute;right:-96rpx;top:40rpx;width:300rpx;height:300rpx;border:54rpx solid #f5cf38;border-radius:50%;transform:rotate(-25deg)}.metrics{display:flex;justify-content:space-around;background:white;border-radius:22rpx;padding:26rpx 12rpx;margin:24rpx 0}.metrics>view{text-align:center;color:#737477;font-size:22rpx}.number{display:block;color:#252629;font-size:46rpx;font-weight:800;margin-bottom:6rpx}.primary{background:#f5cf38;color:#252629}.secondary{background:#efefed;color:#454649;margin-top:14rpx}.wide{width:100%;text-align:left;padding:28rpx}.section{font-size:32rpx;font-weight:700;margin:36rpx 0 22rpx}.card{background:#fff;border:1rpx solid #e2e2df;border-radius:24rpx;padding:26rpx;margin:20rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.title{font-size:29rpx;font-weight:700;margin:10rpx 0;line-height:1.5}.schedule{font-size:27rpx;display:block;font-weight:600;margin:16rpx 0}.empty{padding:58rpx 20rpx;color:#737477;text-align:center;line-height:1.9}.page-title{font-size:42rpx;font-weight:800;margin:22rpx 0}.dates{margin:28rpx 0}.date-row{display:flex;gap:12rpx}.date{min-width:104rpx;background:white;padding:18rpx 8rpx}.date text{display:block;font-size:23rpx;line-height:1.8}.picker{padding:24rpx;background:#fff;border:1rpx solid #e2e2df;border-radius:14rpx;margin:18rpx 0;font-size:26rpx}.picker>text{float:right;color:#737477}.slot-grid{display:flex;flex-wrap:wrap;gap:18rpx}.slot-grid .session{width:calc(50% - 9rpx);margin:0 0 12rpx;padding:20rpx}.time{font-size:44rpx;font-weight:800}.session button{margin-top:20rpx}.pack{background:#f7e6a4;padding:28rpx;border-radius:26rpx;margin-top:24rpx}.pack .metrics{background:transparent;margin:0;padding:26rpx 0}.ledger{padding:22rpx 0;border-bottom:1rpx solid #e2e2df}.bottom-nav{position:fixed;z-index:5;bottom:0;left:0;right:0;display:flex;justify-content:space-around;background:#fff;border-top:1rpx solid #e2e2df;padding:16rpx 10rpx calc(16rpx + env(safe-area-inset-bottom))}.bottom-nav button{background:transparent;padding:20rpx 25rpx;color:#737477}.bottom-nav .on{background:#f5cf38;color:#252629}.error{padding:24rpx;border:1rpx solid #d1ac33;background:#fff7d9;border-radius:16rpx;line-height:1.8;margin:18rpx 0}.error button{margin-top:16rpx}.hint{text-align:center;color:#737477;font-size:24rpx;padding:14rpx}.actions button{flex:1}.compact{font-size:24rpx;padding:14rpx 24rpx;margin:0}.overlay{position:fixed;inset:0;background:#0007;z-index:20;display:flex;align-items:flex-end}.sheet{background:#fff;border-radius:30rpx 30rpx 0 0;width:100%;padding:32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom))}.notice{background:#fff5ce;padding:24rpx;font-size:25rpx;line-height:1.8;margin:24rpx 0;border-radius:16rpx}
